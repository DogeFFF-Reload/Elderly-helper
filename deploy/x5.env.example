# 复制为 deploy/x5.env 后按现场网络修改；两块 X5 用同一份（README §10.9 部署映射）
MASTER_HOST=192.168.1.20      # X5-B：主脑 :8000 + 大屏 + 喇叭 + 执行端
ARM_HOST=127.0.0.1            # 执行端 :8013（USB-RS485 连双手）和主脑在同一块 X5-B，走本机回环，不用改

# X5-A：视觉
CAMERA_INDEX=0                # USB 摄像头编号：v4l2-ctl --list-devices
ROOM=卧室
VISION_ARGS="--fps-cap 10"    # 例：--bed 0.55,0.40,0.98,0.75 标出床的位置（归一化坐标）

# X5-B：语音
TTS_BACKEND=espeak            # 装了 piper 就改成 cmd，并填 TTS_CMD
TTS_CMD=""
WITH_ASR=0                    # 1 = 麦克风接在 X5-B，开机自启 ASR 桥
ASR_ARGS=""                   # 例：--device 2

# 演示默认日间，夜里那段用操作台"夜间模式"开关；X5 时区多半是 UTC，按钟点判断白天也可能亮 🌙（README §10.12）
export CAREMATE_NIGHT_OVERRIDE=off

PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
