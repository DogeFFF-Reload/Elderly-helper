# 复制为 deploy/x5.env 后按现场网络修改；两块 X5 用同一份（README §10.9 部署映射）
MASTER_HOST=192.168.1.20      # X5-B：主脑 :8000 + 大屏 + 喇叭 + 执行端
ARM_HOST=127.0.0.1            # 执行端 :8013（USB-RS485 连双手）和主脑在同一块 X5-B，走本机回环，不用改
ARM_BACKEND=mock              # mock | vendor_sdk；RH56 串口由 MOCK_SERIAL/HAND*_PORT 控制
MOCK_SERIAL=1                 # 1=不碰硬件；0=真手（需先核对 docs/10 并设置 RH56_REGMAP_CONFIRMED=1）
RH56_REGMAP_CONFIRMED=0       # 寄存器表仍是占位值，硬件核对后才改 1
HAND1_PORT=/dev/ttyUSB0
HAND2_PORT=/dev/ttyUSB1
HAND1_ID=1
HAND2_ID=2

# X5-A：视觉
CAMERA_INDEX=0                # USB 摄像头编号：v4l2-ctl --list-devices
ROOM=卧室
VISION_ARGS="--fps-cap 10"    # 例：--bed 0.55,0.40,0.98,0.75 标出床的位置（归一化坐标）

# 手机视觉保底（X5-A，可选；先在手机 IP Webcam 中启动服务器）
PHONE_URL=""                   # 例：http://192.168.1.30:8080
PHONE_ARGS="--thresh 38 --cooldown 30 --arm 1 --room 客厅"

# X5-B：语音
TTS_BACKEND=espeak            # 装了 piper 就改成 cmd，并填 TTS_CMD
TTS_CMD=""
WITH_ASR=0                    # 1 = 麦克风接在 X5-B，开机自启 ASR 桥
ASR_ARGS=""                   # 例：--device 2

PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
